generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  role      Role     @default(REPORTER)
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reportedIncidents Incident[] @relation("ReportedBy")
  qcIncidents      Incident[] @relation("QCBy")
  pmIncidents      Incident[] @relation("PMBy")
  notifications    Notification[] @relation("UserNotifications")

  @@map("users")
}

model Incident {
  id          String   @id @default(cuid())
  ticketId    String   @unique
  title       String
  description String   @db.Text
  location    String
  occurredAt  DateTime
  status      Status   @default(OPEN)
  priority    Priority @default(MEDIUM)
  
  reporterId  String
  reporter    User     @relation("ReportedBy", fields: [reporterId], references: [id])
  
  qcId        String?
  qc          User?    @relation("QCBy", fields: [qcId], references: [id])
  qcAt        DateTime?
  qcComment   String?
  
  pmId        String?
  pm          User?    @relation("PMBy", fields: [pmId], references: [id])
  pmAt        DateTime?
  pmComment   String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attachments IncidentAttachment[]
  logs        IncidentLog[]
  whatsappMessages WhatsAppMessage[]

  @@map("incidents")
}

model IncidentAttachment {
  id         String   @id @default(cuid())
  filename   String
  originalName String
  mimeType   String
  size       Int
  path       String
  
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())

  @@map("incident_attachments")
}

model IncidentLog {
  id         String   @id @default(cuid())
  action     String
  oldStatus  Status?
  newStatus  Status?
  comment    String?
  userId     String
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@map("incident_logs")
}

enum Role {
  ADMIN
  REPORTER
  QC
  PM
}

enum Status {
  OPEN
  ON_HOLD
  PENDING_QC
  QC_APPROVED
  QC_REJECTED
  PENDING_PM
  PM_APPROVED
  PM_REJECTED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model WhatsAppMessage {
  id          String   @id @default(cuid())
  phone       String
  message     String   @db.Text
  status      MessageStatus @default(PENDING)
  type        MessageType
  retryCount  Int      @default(0)
  maxRetries  Int      @default(3)
  incidentId  String?
  incident    Incident? @relation(fields: [incidentId], references: [id])
  error       String?  @db.Text
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("whatsapp_messages")
}

model WhatsAppSession {
  id          String   @id @default(cuid())
  isConnected Boolean  @default(false)
  qrCode      String?  @db.Text
  lastSeen    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("whatsapp_sessions")
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum MessageType {
  INCIDENT_SUBMITTED
  QC_APPROVED
  QC_REJECTED
  PM_APPROVED
  PM_REJECTED
  SYSTEM_NOTIFICATION
  TEST
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("UserNotifications", fields: [userId], references: [id])
  type        String
  title       String
  message     String   @db.Text
  incidentId  String?
  data        Json?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("notifications")
}
